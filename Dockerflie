FROM golang:1.21-alpine AS builder

WORKDIR /app

# Copiar go.mod y go.sum
COPY go.mod go.sum ./
RUN go mod download

# Copiar código fuente
COPY . .

# Compilar
RUN CGO_ENABLED=0 GOOS=linux go build -o /sentinel-proxy cmd/proxy/main.go

# Imagen final
FROM alpine:latest

RUN apk --no-cache add ca-certificates

COPY --from=builder /sentinel-proxy /sentinel-proxy
COPY configs/rules.yaml /configs/rules.yaml

EXPOSE 8080
EXPOSE 9090

ENTRYPOINT ["/sentinel-proxy"]
CMD ["-config", "/configs/rules.yaml", "-port", "8080"]
