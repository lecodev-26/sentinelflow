# === SentinelFlow Production Config ===

# Environment
SENTINELFLOW_ENV=production
SENTINELFLOW_VAULT_KEY=change-me-to-a-strong-random-key

# Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=ant-...

# Redis
REDIS_PASSWORD=change-me-redis-password

# Grafana
GRAFANA_PASSWORD=change-me-grafana-admin

# Database
DB_PATH=/data/sentinelflow.db
