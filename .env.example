# SentinelFlow — variables de entorno de ejemplo
#
# Copia este archivo a .env y rellena los valores.
# NUNCA commitees .env con secretos reales.

# === Entorno ===
# Valores permitidos: development | staging | production
# IMPORTANTE:
#   - development  => auth DESACTIVADA (scopes wildcard) — SOLO para local
#   - cualquier otro valor => auth ACTIVADA (fail-safe)
# Si esta variable está vacía, auth queda ACTIVADA por seguridad.
SENTINELFLOW_ENV=development

# === Base de datos (Postgres / Supabase) ===
# Session pooler (puerto 5432): para migraciones y psql.
# Transaction pooler (puerto 6543): para la app en producción.
# El código usa QueryExecModeExec para ser compatible con pgbouncer.
SENTINELFLOW_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# === Redis (EventBus en producción) ===
# Obligatorio en staging/production. En development, si falta se usa InMemoryBus
# (pero el worker lo requiere igualmente para publicar).
SENTINELFLOW_REDIS_URL=redis://localhost:6379/0

# === Vault (cifrado de secretos en reposo) ===
SENTINELFLOW_VAULT_KEY=change-me-in-production

# === Providers LLM (opcionales; sin ellos solo Ollama funciona) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Autenticación (opcional) ===
# Si SENTINELFLOW_ENV != development, se aplica auth en el gateway.
# El control plane usa OIDC. Ver docs/v3/enterprise.md para más detalle.

# === SCIM (opcional; sin él, SCIM está deshabilitado) ===
SCIM_TOKEN=
